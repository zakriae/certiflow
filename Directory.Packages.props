<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Every package used anywhere in the solution, versioned once. Grouped by the layer that
    consumes it, so an entry appearing under the wrong heading is visible in review.
    Domain projects reference none of them.
  -->
  <ItemGroup Label="Application layer">
    <!--
      MediatR pinned to 12.4.1 deliberately: it is the last Apache-2.0 release. From 12.5.0 the
      package moved to a paid commercial licence. 12.4.1 does everything this project needs from
      it — request/handler dispatch and pipeline behaviours.
    -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!--
      On 10.0.x rather than 9.0.x even though everything targets net9.0. Azure.Core pulls
      Microsoft.Extensions.Hosting.Abstractions 10.0.x transitively, and with central transitive
      pinning enabled a 9.0.x ceiling here is a hard NU1109 downgrade error rather than a warning.
      These packages ship a netstandard2.0 asset, so net9.0 consumes them without issue.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="AI">
    <!--
      The only place an LLM SDK is allowed to appear. It sits behind IFieldExtractor so the domain
      never sees it (SRS §4.3) — which is what let the model change from gpt-4o-mini to gpt-5-mini
      without touching a line of business logic.
    -->
    <!--
      On a beta deliberately. The 2.1.0 stable release still serialises MaxOutputTokenCount as
      `max_tokens`, which every gpt-5-generation model rejects outright with HTTP 400 - the stable
      SDK simply cannot talk to the current model generation. Verified by trying it.
    -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <!-- Keyless auth: DefaultAzureCredential, so no API key exists to leak (NFR-9). -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label="Messaging">
    <!--
      MassTransit pinned to 8.5.10, the last Apache-2.0 release. Version 9 moved to a paid
      commercial licence (massient.com/license). This is the third dependency in this solution
      where the newest version is not the right one - see also MediatR 12.4.1 and
      FluentAssertions 6.12.2. Worth knowing before inheriting a build that needs paid seats.
    -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageVersion Include="MassTransit.Azure.ServiceBus.Core" Version="8.5.10" />
  </ItemGroup>

  <ItemGroup Label="Persistence and storage">
    <!--
      EF Core 9.x, not 10.x: the 10 line targets net10.0 and every service here targets net9.0
      per SRS §5.1. Unlike the Microsoft.Extensions abstractions, EF Core ships no netstandard2.0
      asset to fall back to.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.19" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
  </ItemGroup>

  <ItemGroup Label="Documents">
    <!--
      QuestPDF is dual-licensed. The Community licence is free below $1M annual revenue and must
      be selected explicitly in code (QuestPDF.Settings.License), which the generator does and
      says why. Used twice in this project: generating the synthetic demo corpus, and generating
      compliance report PDFs.
    -->
    <PackageVersion Include="QuestPDF" Version="2026.7.3" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <!--
      PdfPig extracts PDF text *with page numbers*, which is what makes citation grounding
      verifiable rather than decorative. Here it is a test dependency: it proves the generated
      corpus has a text layer the extraction pipeline can actually read.
    -->
    <PackageVersion Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!--
      FluentAssertions pinned to 6.x deliberately: 7.0 moved to a paid commercial licence.
      6.12.x is Apache-2.0 and does everything this project needs.
    -->
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- Asserts the dependency rule of SRS §5.2 so it fails the build, not code review (NFR-18). -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

</Project>
