<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    A worker, not an API. Extraction is queue-driven: it scales on queue depth in Container Apps
    (SRS §5.1) and nothing calls it over HTTP.
  -->

  <PropertyGroup>
    <RootNamespace>Certiflow.Intelligence.Worker</RootNamespace>
    <UserSecretsId>certiflow-intelligence-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Design-time only. dotnet-ef requires this on the *startup* project even though the migrations
      live in the Infrastructure project; PrivateAssets keeps it out of the published output.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Certiflow.Intelligence.Infrastructure/Certiflow.Intelligence.Infrastructure.csproj" />
  </ItemGroup>

</Project>
