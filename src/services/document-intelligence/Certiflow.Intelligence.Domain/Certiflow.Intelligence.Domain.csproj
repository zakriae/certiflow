    no model. PdfPig and the Azure OpenAI SDK live in Infrastructure behind an ACL (SRS §4.3).
  -->

  <PropertyGroup>
    <RootNamespace>Certiflow.Intelligence.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../shared/Certiflow.SharedKernel/Certiflow.SharedKernel.csproj" />
  </ItemGroup>

</Project>
