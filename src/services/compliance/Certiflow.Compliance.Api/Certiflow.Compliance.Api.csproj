<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Certiflow.Compliance.Api</RootNamespace>
    <UserSecretsId>certiflow-compliance-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Design-time only. dotnet-ef requires this on the *startup* project even though the migrations
      live in the Infrastructure project; PrivateAssets keeps it out of the published output.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../shared/Certiflow.Http/Certiflow.Http.csproj" />
    <ProjectReference Include="../Certiflow.Compliance.Application/Certiflow.Compliance.Application.csproj" />
    <ProjectReference Include="../Certiflow.Compliance.Infrastructure/Certiflow.Compliance.Infrastructure.csproj" />
  </ItemGroup>

</Project>
