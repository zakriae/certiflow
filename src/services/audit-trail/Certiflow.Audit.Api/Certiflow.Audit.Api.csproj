<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Certiflow.Audit.Api</RootNamespace>
    <UserSecretsId>certiflow-audit-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Design-time only. dotnet-ef requires this on the *startup* project even though the migrations
      live in the Infrastructure project; PrivateAssets keeps it out of the published output.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../shared/Certiflow.Http/Certiflow.Http.csproj" />
    <ProjectReference Include="../Certiflow.Audit.Infrastructure/Certiflow.Audit.Infrastructure.csproj" />
  </ItemGroup>
</Project>
