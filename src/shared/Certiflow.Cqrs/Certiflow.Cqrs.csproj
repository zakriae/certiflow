<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared MediatR plumbing, on the same footing as Certiflow.Persistence and Certiflow.Http: it is
    Infrastructure that every Application layer needs, and it may never hold a business concept.
    It cannot live in Certiflow.SharedKernel, which deliberately has zero NuGet dependencies.
  -->

  <PropertyGroup>
    <RootNamespace>Certiflow.Cqrs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
