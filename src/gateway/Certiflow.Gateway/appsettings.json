{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "Issuer": "",
    "Audience": "certiflow-api"
  },
  "Cors": {
    "SpaOrigin": ""
  },
  "ReverseProxy": {
    "Routes": {
      "review-tasks-write": {
        "ClusterId": "verification",
        "AuthorizationPolicy": "reviewer",
        "Match": {
          "Path": "/api/review-tasks/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "Order": 1
      },
      "review-tasks-read": {
        "ClusterId": "verification",
        "AuthorizationPolicy": "read-everything",
        "Match": {
          "Path": "/api/review-tasks/{**catch-all}"
        },
        "Order": 2
      },
      "documents-write": {
        "ClusterId": "intake",
        "AuthorizationPolicy": "upload",
        "Match": {
          "Path": "/api/documents/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "Order": 1
      },
      "documents-read": {
        "ClusterId": "intake",
        "AuthorizationPolicy": "read-everything",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        },
        "Order": 2
      },
      "suppliers-read": {
        "ClusterId": "compliance",
        "AuthorizationPolicy": "read-everything",
        "Match": {
          "Path": "/api/suppliers/{**catch-all}"
        },
        "Order": 2
      },
      "dashboard-read": {
        "ClusterId": "compliance",
        "AuthorizationPolicy": "read-everything",
        "Match": {
          "Path": "/api/dashboard/{**catch-all}"
        },
        "Order": 2
      },
      "reports-write": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "read-everything",
        "Match": {
          "Path": "/api/reports/{**catch-all}",
          "Methods": [
            "POST"
          ]
        },
        "Order": 1
      },
      "reports-read": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "read-everything",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        },
        "Order": 2
      },
      "audit-read": {
        "ClusterId": "audit",
        "AuthorizationPolicy": "read-everything",
        "Match": {
          "Path": "/api/audit/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Order": 1
      },
      "registry-write": {
        "ClusterId": "registry",
        "AuthorizationPolicy": "admin",
        "Match": {
          "Path": "/api/registry/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "Order": 1,
        "Transforms": [
          {
            "PathRemovePrefix": "/api/registry"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "registry-read": {
        "ClusterId": "registry",
        "AuthorizationPolicy": "read-everything",
        "Match": {
          "Path": "/api/registry/{**catch-all}"
        },
        "Order": 2,
        "Transforms": [
          {
            "PathRemovePrefix": "/api/registry"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      }
    },
    "Clusters": {
      "registry": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "intake": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "verification": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "compliance": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "audit": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "reporting": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      }
    }
  }
}
