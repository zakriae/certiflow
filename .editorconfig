root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,js,html,scss,css,md}]
indent_size = 2

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.cs]
# Usings
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Modern C# the project leans on (tech-stack doc §1)
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_collection_expression = true:suggestion

# Immutability discipline — value objects and aggregate state
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Naming
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# Analyzer noise that fights DDD style
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA2007.severity = none

# ── EF migrations ───────────────────────────────────────────────────────────────────────────────
# Scaffolded by `dotnet ef migrations add`, not written by hand. Holding generated code to the
# project's style rules means either editing every regenerated file back into compliance or
# suppressing the rule everywhere — and the second is how a real style rule quietly dies.
#
# `generated_code = true` is the honest label: these files are generated, they are regenerated on
# every model change, and nobody should be reviewing their brace placement.
[**/Persistence/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE0005.severity = none
